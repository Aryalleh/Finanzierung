{
  "name": "finanzierung",
  "version": "1.0.0",
  "description": "مدیریت حقوق ماهانه — یک PWA روی Cloudflare Workers برای مدیریت پاکت‌های بودجه (ورودی، خروجی و موجودی هر بخش)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create finanzierung",
    "db:init": "wrangler d1 execute finanzierung --remote --file=./migrations/0001_init.sql",
    "db:init:local": "wrangler d1 execute finanzierung --local --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
